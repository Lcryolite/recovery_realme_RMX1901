+			bool pending = strstr(status, "state=pending\n");
+			bool ready = strstr(status, "state=ok\n");
+			bool unready = !failed && (pending || !ready);
+			if (unready && !diagnostics_waiting) {
+				diagnostics_waiting = true;
+				diagnostics_unready_since = diagnostics_now;
+			} else if (!unready) {
+				diagnostics_waiting = false;
+			}
+			bool stale = unready && diagnostics_now.tv_sec - diagnostics_unready_since.tv_sec >= 15;
+			std::string warning = failed ? status : (stale ? "status_unavailable" : "");
+			if (!warning.empty() && warning != diagnostics_warning) {
+				diagnostics_warning = warning;
+				gui_changeOverlay("dialog_rmx_diagnostics_warning");
+			} else if (warning.empty()) {
+				diagnostics_warning.clear();
+			}
+		}
 		FD_ZERO(&fdset);
 		timeout.tv_sec = 0;
 		timeout.tv_usec = 1;
