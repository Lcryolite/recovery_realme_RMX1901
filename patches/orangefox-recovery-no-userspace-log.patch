+static bool pause_cache_diagnostics(bool *resume)
+{
+	char state[PROPERTY_VALUE_MAX] = {};
+	*resume = false;
+	property_get("init.svc.rmx1901-diagnostics", state, "");
+	if (!state[0] || !strcmp(state, "stopped"))
+		return true;
+	int cache_fd = open("/cache", O_RDONLY | O_DIRECTORY | O_CLOEXEC | O_NOFOLLOW);
+	if (cache_fd < 0)
+		return false;
+	int synced = syncfs(cache_fd);
+	int closed = close(cache_fd);
+	if (synced || closed)
+		return false;
+	*resume = true;
+	if (property_set("ctl.stop", "rmx1901-diagnostics"))
+		return false;
+	for (int i = 0; i < 100; i++) {
+		property_get("init.svc.rmx1901-diagnostics", state, "");
+		if (!strcmp(state, "stopped"))
+			return true;
+		usleep(50000);
+	}
+	return false;
+}
+
+static void resume_cache_diagnostics(bool resume)
+{
+	if (!resume)
+		return;
+	int fd = open("/tmp/rmx1901-diagnostics.status", O_WRONLY | O_CLOEXEC | O_NOFOLLOW);
+	if (fd >= 0) {
+		struct stat st;
+		const char pending[] = "state=pending\nreason=cache_transition\n";
+		if (!fstat(fd, &st) && S_ISREG(st.st_mode) && st.st_uid == 0 && !(st.st_mode & 0077) &&
+		    !ftruncate(fd, 0) && write(fd, pending, sizeof(pending) - 1) != static_cast<ssize_t>(sizeof(pending) - 1))
+			LOGERR("Unable to reset diagnostics status after cache operation\n");
+		close(fd);
+	}
+	if (property_set("ctl.start", "rmx1901-diagnostics"))
+		gui_msg(Msg(msg::kWarning, "diagnostics_resume_failed=Unable to restart diagnostics after cache operation."));
+}
+
