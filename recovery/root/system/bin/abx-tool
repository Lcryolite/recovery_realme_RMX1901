#!/bin/sh
''''which python3 >/dev/null 2>&1 && exec python3 "$0" "$@" || {
    for p in /system/bin/python3 /system/bin/python /sbin/python3 /sbin/python python3 python; do
        command -v "$p" >/dev/null 2>&1 && exec "$p" "$0" "$@"
        [ -x "$p" ] && exec "$p" "$0" "$@"
    done
    echo "abx-tool: Python 3 interpreter not found in recovery" >&2
    exit 127
}
'''
"""Android Binary XML (ABX) converter and rescue utility for Recovery environments.

Supports bidirectional conversion between Android 12-16 Binary XML (ABX)
and standard plain-text XML for the token, namespace, and mixed-content forms
that can be represented safely by this implementation.
"""

import argparse
import io
import struct
import sys
import xml.etree.ElementTree as ET
import xml.sax.saxutils as saxutils
from pathlib import Path
from typing import BinaryIO, Dict, List, Optional, Set, Tuple

ABX_MAGIC = b"ABX\x00"

# Token constants (lower 4 bits)
START_DOCUMENT = 0
END_DOCUMENT = 1
START_TAG = 2
END_TAG = 3
TEXT = 4
CDSECT = 5
ENTITY_REF = 6
IGNORABLE_WHITESPACE = 7
PROCESSING_INSTRUCTION = 8
COMMENT = 9
DOCDECL = 10
ATTRIBUTE = 15

# Type constants (upper 4 bits)
TYPE_NULL = 1
TYPE_STRING = 2
TYPE_STRING_INTERNED = 3
TYPE_BYTES_HEX = 4
TYPE_BYTES_BASE64 = 5
TYPE_INT = 6
TYPE_INT_HEX = 7
TYPE_LONG = 8
TYPE_LONG_HEX = 9
TYPE_FLOAT = 10
TYPE_DOUBLE = 11
TYPE_BOOLEAN_TRUE = 12
TYPE_BOOLEAN_FALSE = 13

KNOWN_NAMESPACES = {
    "android": "http://schemas.android.com/apk/res/android",
    "app": "http://schemas.android.com/apk/res-auto",
    "tools": "http://schemas.android.com/tools",
}
PREDEFINED_NAMESPACES = {
    "xml": "http://www.w3.org/XML/1998/namespace",
}
SUPPORTED_NAMESPACES = {**KNOWN_NAMESPACES, **PREDEFINED_NAMESPACES}
NAMESPACE_PREFIXES = {uri: prefix for prefix, uri in SUPPORTED_NAMESPACES.items()}


class ABXTreeBuilder(ET.TreeBuilder):
    """Tree builder that retains comments and processing instructions outside the root."""

    def __init__(self) -> None:
        super().__init__(insert_comments=True, insert_pis=True)
        self.depth = 0
        self.root_closed = False
        self.leading_nodes: List[ET.Element] = []
        self.trailing_nodes: List[ET.Element] = []

    def start(self, tag: str, attrs: Dict[str, str]) -> ET.Element:
        self.depth += 1
        return super().start(tag, attrs)

    def end(self, tag: str) -> ET.Element:
        node = super().end(tag)
        self.depth -= 1
        if self.depth == 0:
            self.root_closed = True
        return node

    def comment(self, data: str) -> None:
        node = ET.Comment(data)
        target = self.trailing_nodes if self.root_closed else self.leading_nodes
        if self.depth == 0:
            target.append(node)
        else:
            super().comment(data)

    def pi(self, target: str, data: Optional[str] = None) -> None:
        node = ET.ProcessingInstruction(target, data or "")
        target_nodes = self.trailing_nodes if self.root_closed else self.leading_nodes
        if self.depth == 0:
            target_nodes.append(node)
        else:
            super().pi(target, data)

    def doctype(self, name: str, pubid: Optional[str], system: Optional[str]) -> None:
        raise ValueError("DOCTYPE is not supported by xml2abx without data loss")


def is_abx(data: bytes) -> bool:
    """Check if the provided byte stream starts with the ABX magic signature."""
    return bool(data and data.startswith(ABX_MAGIC))


def _resolve_qname(name: str, ns_map: Dict[str, str]) -> str:
    """Map Clark notation {uri}localname to a supported prefix."""
    if name.startswith("{"):
        try:
            uri, local = name[1:].split("}", 1)
        except ValueError as exc:
            raise ValueError(f"Malformed qualified XML name: {name!r}") from exc
        prefix = ns_map.get(uri)
        if prefix is None:
            raise ValueError(f"Unsupported XML namespace URI: {uri}")
        return f"{prefix}:{local}"
    return name


def _validate_abx_qname(name: str, *, is_attribute: bool = False) -> None:
    """Reject ABX names whose prefix cannot be mapped to a declared XML namespace."""
    parts = name.split(":")
    if len(parts) > 2 or any(not part for part in parts):
        raise ValueError(f"Unsupported ABX namespace prefix in name: {name!r}")
    if len(parts) == 2 and parts[0] not in SUPPORTED_NAMESPACES:
        raise ValueError(f"Unsupported ABX namespace prefix in name: {name!r}")
    if is_attribute and name == "xmlns":
        raise ValueError("ABX namespace declarations are not supported as attributes")


class FastDataInput:
    """Stream reader supporting Android Binary XML data formats and string interning."""

    def __init__(self, stream: BinaryIO):
        self.stream = stream
        self.strings: List[str] = []

    def read_bytes(self, count: int) -> bytes:
        data = self.stream.read(count)
        if len(data) < count:
            raise EOFError(f"Unexpected end of stream: expected {count} bytes, got {len(data)}")
        return data

    def read_byte(self) -> int:
        return self.read_bytes(1)[0]

    def read_short(self) -> int:
        return struct.unpack(">H", self.read_bytes(2))[0]

    def read_int(self) -> int:
        return struct.unpack(">i", self.read_bytes(4))[0]

    def read_long(self) -> int:
        return struct.unpack(">q", self.read_bytes(8))[0]

    def read_float(self) -> float:
        return struct.unpack(">f", self.read_bytes(4))[0]

    def read_double(self) -> float:
        return struct.unpack(">d", self.read_bytes(8))[0]

    def read_utf(self) -> str:
        length = self.read_short()
        raw = self.read_bytes(length)
        return raw.decode("utf-8")

    def read_interned_utf(self) -> str:
        ref = self.read_short()
        if ref == 0xFFFF:
            s = self.read_utf()
            self.strings.append(s)
            return s
        if 0 <= ref < len(self.strings):
            return self.strings[ref]
        raise ValueError(f"Invalid string intern reference: {ref} (pool size: {len(self.strings)})")

    def peek_byte(self) -> Optional[int]:
        pos = self.stream.tell()
        data = self.stream.read(1)
        self.stream.seek(pos)
        return data[0] if data else None


class FastDataOutput:
    """Stream writer supporting Android Binary XML data formats and string interning."""

    def __init__(self, stream: BinaryIO):
        self.stream = stream
        self.string_refs: Dict[str, int] = {}

    def write_bytes(self, data: bytes) -> None:
        self.stream.write(data)

    def write_byte(self, val: int) -> None:
        self.stream.write(bytes([val & 0xFF]))

    def write_short(self, val: int) -> None:
        self.stream.write(struct.pack(">H", val & 0xFFFF))

    def write_int(self, val: int) -> None:
        self.stream.write(struct.pack(">i", val))

    def write_long(self, val: int) -> None:
        self.stream.write(struct.pack(">q", val))

    def write_float(self, val: float) -> None:
        self.stream.write(struct.pack(">f", val))

    def write_double(self, val: float) -> None:
        self.stream.write(struct.pack(">d", val))

    def write_utf(self, s: str) -> None:
        data = s.encode("utf-8")
        if len(data) > 0xFFFF:
            raise ValueError(f"String length {len(data)} exceeds max unsigned short (65535)")
        self.write_short(len(data))
        self.write_bytes(data)

    def write_interned_utf(self, s: str) -> None:
        if s in self.string_refs:
            self.write_short(self.string_refs[s])
        else:
            self.write_short(0xFFFF)
            self.write_utf(s)
            self.string_refs[s] = len(self.string_refs)


def _read_token_string(reader: FastDataInput, type_tag: int, token_name: str) -> str:
    if type_tag == TYPE_STRING:
        return reader.read_utf()
    if type_tag == TYPE_STRING_INTERNED:
        return reader.read_interned_utf()
    raise ValueError(f"Unsupported ABX {token_name} type: {type_tag}")


def _infer_attribute_value(value: str) -> Tuple[int, object]:
    if value.lower() == "true":
        return TYPE_BOOLEAN_TRUE, None
    if value.lower() == "false":
        return TYPE_BOOLEAN_FALSE, None

    lower_value = value.lower()
    if lower_value.startswith(("0x", "-0x")):
        try:
            number = int(value, 16)
            if hex(number) == lower_value:
                if -2147483648 <= number <= 2147483647:
                    return TYPE_INT_HEX, number
                if -9223372036854775808 <= number <= 9223372036854775807:
                    return TYPE_LONG_HEX, number
        except ValueError:
            pass

    if value == "0" or (
        value.lstrip("-").isdigit()
        and not value.startswith("0")
        and not value.startswith("-0")
    ):
        number = int(value)
        if -2147483648 <= number <= 2147483647:
            return TYPE_INT, number
        if -9223372036854775808 <= number <= 9223372036854775807:
            return TYPE_LONG, number

    if "." in value:
        try:
            number = float(value)
            float32 = struct.unpack(">f", struct.pack(">f", number))[0]
            if str(float32) == value:
                return TYPE_FLOAT, float32
            if str(number) == value:
                return TYPE_DOUBLE, number
        except (ValueError, OverflowError, struct.error):
            pass

    return TYPE_STRING, value


def abx2xml(data: bytes) -> str:
    """Decode Android Binary XML (ABX) binary payload into a formatted XML string."""
    if not is_abx(data):
        raise ValueError("Provided data is not a valid Android Binary XML (missing ABX header)")

    stream = io.BytesIO(data[4:])
    reader = FastDataInput(stream)

    parts: List[str] = ['<?xml version="1.0" encoding="utf-8"?>\n']
    root_part_index: Optional[int] = None
    used_prefixes: Set[str] = set()
    document_started = False
    document_ended = False

    while True:
        b = reader.peek_byte()
        if b is None:
            break
        b = reader.read_byte()
        token = b & 0x0F
        type_tag = b >> 4

        if token == START_DOCUMENT:
            if type_tag != TYPE_NULL or document_started:
                raise ValueError("Invalid or duplicate ABX start-document token")
            document_started = True
            continue
        if not document_started:
            raise ValueError("ABX content appears before the start-document token")
        if token == END_DOCUMENT:
            if type_tag != TYPE_NULL:
                raise ValueError("Invalid ABX end-document token type")
            document_ended = True
            if reader.peek_byte() is not None:
                raise ValueError("ABX stream contains data after the end-document token")
            break
        elif token == START_TAG:
            tag_name = _read_token_string(reader, type_tag, "start-tag")
            _validate_abx_qname(tag_name)
            if ":" in tag_name:
                used_prefixes.add(tag_name.split(":", 1)[0])

            attrs: List[Tuple[str, str]] = []
            while True:
                next_b = reader.peek_byte()
                if next_b is None or (next_b & 0x0F) != ATTRIBUTE:
                    break
                next_b = reader.read_byte()
                attr_type = next_b >> 4
                attr_name = reader.read_interned_utf()
                _validate_abx_qname(attr_name, is_attribute=True)
                if ":" in attr_name:
                    used_prefixes.add(attr_name.split(":", 1)[0])

                if attr_type == TYPE_STRING:
                    attr_val = reader.read_utf()
                elif attr_type == TYPE_STRING_INTERNED:
                    attr_val = reader.read_interned_utf()
                elif attr_type == TYPE_INT:
                    attr_val = str(reader.read_int())
                elif attr_type == TYPE_INT_HEX:
                    attr_val = hex(reader.read_int())
                elif attr_type == TYPE_LONG:
                    attr_val = str(reader.read_long())
                elif attr_type == TYPE_LONG_HEX:
                    attr_val = hex(reader.read_long())
                elif attr_type == TYPE_FLOAT:
                    attr_val = str(reader.read_float())
                elif attr_type == TYPE_DOUBLE:
                    attr_val = str(reader.read_double())
                elif attr_type == TYPE_BOOLEAN_TRUE:
                    attr_val = "true"
                elif attr_type == TYPE_BOOLEAN_FALSE:
                    attr_val = "false"
                elif attr_type in (TYPE_NULL, TYPE_BYTES_HEX, TYPE_BYTES_BASE64):
                    raise ValueError(
                        f"ABX attribute type {attr_type} cannot be represented losslessly as XML"
                    )
                else:
                    raise ValueError(f"Unsupported ABX attribute type: {attr_type}")

                inferred_type = _infer_attribute_value(attr_val)[0]
                comparable_type = TYPE_STRING if attr_type == TYPE_STRING_INTERNED else attr_type
                if inferred_type != comparable_type:
                    raise ValueError(
                        f"ABX attribute {attr_name!r} cannot round-trip without changing type"
                    )
                attrs.append((attr_name, attr_val))

            attr_str = "".join(f" {k}={saxutils.quoteattr(v)}" for k, v in attrs)
            parts.append(f"<{tag_name}{attr_str}>")
            if root_part_index is None:
                root_part_index = len(parts) - 1

        elif token == TEXT:
            text_content = _read_token_string(reader, type_tag, "text")
            parts.append(saxutils.escape(text_content))

        elif token == CDSECT:
            raise ValueError("ABX CDATA tokens cannot round-trip losslessly")

        elif token == COMMENT:
            comment_content = _read_token_string(reader, type_tag, "comment")
            parts.append(f"<!--{comment_content}-->")

        elif token == DOCDECL:
            raise ValueError("ABX document declarations cannot round-trip losslessly")

        elif token == ENTITY_REF:
            raise ValueError("ABX entity-reference tokens cannot round-trip losslessly")

        elif token == PROCESSING_INSTRUCTION:
            pi_content = _read_token_string(reader, type_tag, "processing instruction")
            parts.append(f"<?{pi_content}?>")

        elif token == IGNORABLE_WHITESPACE:
            raise ValueError("ABX ignorable-whitespace tokens cannot round-trip losslessly")

        elif token == END_TAG:
            tag_name = _read_token_string(reader, type_tag, "end-tag")
            _validate_abx_qname(tag_name)
            parts.append(f"</{tag_name}>")

        else:
            raise ValueError(f"Invalid or unexpected ABX token: {token} (byte: {b:#04x})")

    if not document_ended:
        raise ValueError("ABX stream is missing the end-document token")
    if root_part_index is None:
        raise ValueError("ABX stream does not contain a root element")

    namespace_attrs = "".join(
        f" xmlns:{prefix}={saxutils.quoteattr(KNOWN_NAMESPACES[prefix])}"
        for prefix in sorted(used_prefixes)
        if prefix in KNOWN_NAMESPACES
    )
    root_part = parts[root_part_index]
    insert_at = root_part.rfind(">")
    if insert_at < 0:
        raise ValueError("ABX root element has malformed output")
    parts[root_part_index] = root_part[:insert_at] + namespace_attrs + root_part[insert_at:]

    res = "".join(parts)
    if not res.endswith("\n"):
        res += "\n"
    try:
        ET.fromstring(res)
    except ET.ParseError as exc:
        raise ValueError(f"ABX stream does not produce well-formed XML: {exc}") from exc
    return res


def _encode_node(writer: FastDataOutput, node: ET.Element, ns_map: Dict[str, str]) -> None:
    """Encode an XML node (Element, Comment, or PI) into ABX stream."""
    tag = node.tag

    # Handle Comments
    if tag is ET.Comment:
        writer.write_byte(COMMENT | (TYPE_STRING << 4))
        writer.write_utf(node.text or "")
        return

    # Handle Processing Instructions
    if tag is ET.ProcessingInstruction:
        writer.write_byte(PROCESSING_INSTRUCTION | (TYPE_STRING << 4))
        writer.write_utf(node.text or "")
        return

    tag_name = _resolve_qname(str(tag), ns_map)
    writer.write_byte(START_TAG | (TYPE_STRING_INTERNED << 4))
    writer.write_interned_utf(tag_name)

    # Encode attributes with type inference
    for raw_attr_name, attr_val in node.attrib.items():
        attr_name = _resolve_qname(raw_attr_name, ns_map)
        attr_type, encoded_value = _infer_attribute_value(attr_val)
        writer.write_byte(ATTRIBUTE | (attr_type << 4))
        writer.write_interned_utf(attr_name)

        if attr_type == TYPE_STRING:
            writer.write_utf(str(encoded_value))
        elif attr_type in (TYPE_INT, TYPE_INT_HEX):
            writer.write_int(int(encoded_value))
        elif attr_type in (TYPE_LONG, TYPE_LONG_HEX):
            writer.write_long(int(encoded_value))
        elif attr_type == TYPE_FLOAT:
            writer.write_float(float(encoded_value))
        elif attr_type == TYPE_DOUBLE:
            writer.write_double(float(encoded_value))

    # Text content (exact whitespace preserved)
    if node.text:
        writer.write_byte(TEXT | (TYPE_STRING << 4))
        writer.write_utf(node.text)

    # Children with tail text support
    for child in node:
        _encode_node(writer, child, ns_map)
        if child.tail:
            writer.write_byte(TEXT | (TYPE_STRING << 4))
            writer.write_utf(child.tail)

    # End tag
    writer.write_byte(END_TAG | (TYPE_STRING_INTERNED << 4))
    writer.write_interned_utf(tag_name)


def xml2abx(xml_str: str) -> bytes:
    """Encode representable XML into a standard Android Binary XML (ABX) payload."""
    builder = ABXTreeBuilder()
    parser = ET.XMLParser(target=builder)
    parser.feed(xml_str)
    root = parser.close()

    events = ET.iterparse(io.StringIO(xml_str), events=["start-ns"])
    ns_map: Dict[str, str] = dict(NAMESPACE_PREFIXES)
    for _, (_, uri) in events:
        if uri and uri not in NAMESPACE_PREFIXES:
            raise ValueError(f"Unsupported XML namespace URI: {uri}")

    out = io.BytesIO()
    writer = FastDataOutput(out)

    writer.write_bytes(ABX_MAGIC)
    writer.write_byte(START_DOCUMENT | (TYPE_NULL << 4))

    for node in builder.leading_nodes:
        _encode_node(writer, node, ns_map)
    _encode_node(writer, root, ns_map)
    for node in builder.trailing_nodes:
        _encode_node(writer, node, ns_map)

    writer.write_byte(END_DOCUMENT | (TYPE_NULL << 4))
    return out.getvalue()


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        description="Android Binary XML (ABX) bidirectional converter and recovery tool."
    )
    subparsers = parser.add_subparsers(dest="command", required=True)

    # decode command
    decode_p = subparsers.add_parser("decode", help="Decode an ABX file to readable XML")
    decode_p.add_argument("input", type=Path, help="Input ABX file (or - for stdin)")
    decode_p.add_argument("output", type=Path, nargs="?", help="Output XML file (or stdout)")

    # encode command
    encode_p = subparsers.add_parser("encode", help="Encode an XML file to Android Binary XML")
    encode_p.add_argument("input", type=Path, help="Input XML file (or - for stdin)")
    encode_p.add_argument("output", type=Path, nargs="?", help="Output ABX file (or stdout)")

    # info command
    info_p = subparsers.add_parser("info", help="Display ABX file metadata")
    info_p.add_argument("input", type=Path, help="Input file")

    return parser


def main(argv: Optional[List[str]] = None) -> int:
    args = build_parser().parse_args(argv)

    try:
        if args.command == "decode":
            input_data = (
                sys.stdin.buffer.read()
                if str(args.input) == "-"
                else args.input.read_bytes()
            )
            if not is_abx(input_data):
                xml_out = input_data.decode("utf-8", errors="replace")
            else:
                xml_out = abx2xml(input_data)

            if args.output and str(args.output) != "-":
                args.output.write_text(xml_out, encoding="utf-8")
            else:
                sys.stdout.write(xml_out)

        elif args.command == "encode":
            input_text = (
                sys.stdin.read()
                if str(args.input) == "-"
                else args.input.read_text(encoding="utf-8")
            )
            abx_out = xml2abx(input_text)
            if args.output and str(args.output) != "-":
                args.output.write_bytes(abx_out)
            else:
                sys.stdout.buffer.write(abx_out)

        elif args.command == "info":
            input_data = args.input.read_bytes()
            if is_abx(input_data):
                print(f"{args.input}: Valid Android Binary XML (ABX v0), size={len(input_data)} bytes")
            else:
                print(f"{args.input}: Plain-text XML or non-ABX data, size={len(input_data)} bytes")

    except Exception as e:
        print(f"abx-tool error: {e}", file=sys.stderr)
        return 1

    return 0


if __name__ == "__main__":
    raise SystemExit(main())
